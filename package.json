{
  "name": "pcb-kaardistaja",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run depcruise && pnpm run filelength && pnpm run test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --output-type err packages apps",
    "filelength": "node tooling/check-file-length.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
