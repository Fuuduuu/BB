{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": [
    "packages/domain/src/**/*",
    "packages/contracts/src/**/*",
    "packages/engine/src/**/*",
    "packages/features/*/contract.ts",
    "packages/features/*/engine/**/*",
    "tooling/types/host-timers.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.test-d.ts",
    "**/__tests__/**",
    "**/tests/**"
  ]
}
